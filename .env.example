# Application Settings
APP_NAME=Meme Tracker API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Ingestion Settings
POLL_INTERVAL_SECONDS=60
OFFLINE_MODE=false
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3

# Subreddits to Track
REDDIT_SUBREDDITS=["memes", "dankmemes", "me_irl", "wholesomememes"]

# Know Your Meme RSS Feeds
KYM_FEED_URLS=["https://knowyourmeme.com/memes.rss", "https://knowyourmeme.com/news.rss"]

# Database Storage
DB_PATH=data/memes.db
